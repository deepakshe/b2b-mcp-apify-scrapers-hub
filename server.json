  ],
  "remotes": [
    {
      "transport": {
        "type": "streamable-http",
        "url": "https://mcp.apify.com/?tools=deepaksheoran172/b2b-lead-domain-intelligence-suite,deepaksheoran172/store-catalog-redirect-extractor,deepaksheoran172/domain-security-super-auditor"
      }
    }
  ]
}
