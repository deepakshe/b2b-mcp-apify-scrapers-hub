{
  "name": "Apify Sync - OpenRouter LLM Token Pricing & MCP Tool Schema Registry",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1-5"
            }
          ]
        }
      },
      "id": "1",
      "name": "Daily Schedule (9 AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/deepaksheoran172~openrouter-mcp-registry/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $env.APIFY_TOKEN || 'YOUR_APIFY_API_TOKEN' }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "{\"mode\": \"models\", \"free_only\": false, \"multimodal_only\": false, \"min_context\": 32768}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "2",
      "name": "Run openrouter-mcp-registry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Filter fresh items and prepare alerts\nconst items = $input.all();\nreturn items.filter(item => item.json && item.json.status !== 'NO_NEW_ITEMS');"
      },
      "id": "3",
      "name": "Filter Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    }
  ],
  "connections": {
    "Daily Schedule (9 AM)": {
      "main": [
        [
          {
            "node": "Run openrouter-mcp-registry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run openrouter-mcp-registry": {
      "main": [
        [
          {
            "node": "Filter Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}